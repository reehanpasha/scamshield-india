# ScamShield India - Environment Configuration Example
PROJECT_NAME="ScamShield India"
VERSION="1.2.0"
RULES_VERSION="v1.2.0-in"
ENVIRONMENT="development"

# SQLite Database (or PostgreSQL: postgresql://user:pass@localhost/scamshield)
DATABASE_URL="sqlite:///./scamshield.db"

# Safety Controls
ALLOW_PRIVATE_IP_SCAN=false
MAX_URL_LENGTH=2048
MAX_MESSAGE_LENGTH=50000

# Optional External Threat Intelligence Integrations
# The application operates at 100% full local deterministic capacity without these keys.
ENABLE_EXTERNAL_PROVIDERS=false
VIRUSTOTAL_API_KEY=""
GOOGLE_SAFE_BROWSING_KEY=""

# Optional AI Context Enrichment
GEMINI_API_KEY=""
OPENAI_API_KEY=""
